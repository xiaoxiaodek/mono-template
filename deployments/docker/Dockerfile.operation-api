# syntax=docker/dockerfile:1.7

FROM golang:1.26-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/operation-api ./apps/operation-api/cmd/server

FROM alpine:3.23

RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 app \
    && adduser -S -D -H -u 10001 -G app app

WORKDIR /app

COPY --from=build --chown=app:app /out/operation-api /app/operation-api
COPY --chown=app:app configs/ /app/configs/

ENV APP_ENV=prod \
    CONFIG_DIR=/app/configs

USER 10001:10001
EXPOSE 8080

ENTRYPOINT ["/app/operation-api"]
